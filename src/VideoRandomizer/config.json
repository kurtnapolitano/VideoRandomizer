{
  // ---------------------------------------------------------------------------
  //  VideoRandomizer configuration
  //
  //  Paths: use forward slashes  ->  "C:/Videos"
  //         or doubled backslashes -> "C:\\Videos"
  //         Network shares work too -> "//server/share/Videos"
  // ---------------------------------------------------------------------------

  // Folder containing the videos to play.
  "videoFolder": "C:/Videos",

  // Which files in that folder count as videos.
  "videoExtensions": [ ".mp4", ".mkv", ".avi", ".mov", ".wmv", ".m4v", ".webm", ".mpg", ".mpeg" ],

  // Folder containing the bumpers shown between videos. Bumpers can be still images or short
  // video clips; both can live in this folder and one is picked at random each time.
  // Leave this blank ("") to turn bumpers off entirely.
  "bumperFolder": "C:/Bumpers",

  // Which files in that folder are shown as still images.
  "bumperImageExtensions": [ ".jpg", ".jpeg", ".png", ".bmp", ".gif", ".webp" ],

  // Which files in that folder are played as video clips.
  // Set this to [] if you only want still images.
  "bumperVideoExtensions": [ ".mp4", ".mkv", ".avi", ".mov", ".wmv" ],

  // How long each bumper IMAGE stays on screen, in milliseconds. 5000 = 5 seconds.
  // Bumper videos ignore this and play to their end. Set to 0 for video bumpers only.
  "bumperDurationMs": 5000,

  // Also scan subfolders of the two folders above.
  "searchSubfolders": false,

  // Play videos with the sound muted.
  "muteAudio": false
}
